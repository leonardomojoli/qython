# ============================================================
# Qython - Variáveis de Ambiente
# ============================================================
# IMPORTANTE: Este arquivo (.env) contém credenciais sensíveis.
# NUNCA faça commit deste arquivo no Git!
# Copie .env.example para .env e preencha com suas credenciais reais.

# ============================================================
# BANCO DE DADOS (OBRIGATÓRIO)
# ============================================================
DATABASE_URL=postgresql://user:password@localhost:5432/qythondb?sslmode=require

# ============================================================
# AUTENTICAÇÃO E SEGURANÇA (OBRIGATÓRIO)
# ============================================================
JWT_SECRET_KEY=sua_chave_jwt_secreta_minimo_32_caracteres
ACCESS_TOKEN_EXPIRE_MINUTES=720

# Cloudflare Turnstile (CAPTCHA)
CLOUDFLARE_SECRET_KEY=sua_chave_secreta_cloudflare
VITE_CLOUDFLARE_SITE_KEY=sua_chave_site_cloudflare

# ============================================================
# GOOGLE AI / GEMINI (OBRIGATÓRIO)
# ============================================================
GEMINI_API_KEY=sua_chave_gemini

# ============================================================
# MODELOS LLM - Janeiro 2026
# ============================================================
# PRIMARY: Funções médicas críticas (consultas, chat, resumos, relatórios)
# Gemini 3 Flash: Frontier performance, PhD-level reasoning (GPQA 90.4%)
# - 3x mais rápido que Gemini 2.5 Pro com qualidade equivalente
# - $0.50/1M input tokens, $3.00/1M output tokens
# - Suporta thinking_level: minimal, low, medium, high
# - Recomendado: temperature=1.0 (otimizado para raciocínio)
# - Context window: 1M tokens input, 64k tokens output
PRIMARY_LLM_MODEL=gemini-3-flash-preview
# FALLBACK: Modelo caso Gemini 3 Flash tenha problemas (503, etc)
# Gemini 3.1 Flash-Lite: $0.25/$1.50 por 1M tokens — mais barato e rápido que 2.5 Flash
FALLBACK_LLM_MODEL=gemini-3.1-flash-lite-preview
# SIMPLE: Tarefas simples (classificação, CID-10, títulos, ícones)
# Gemini 2.5 Flash-Lite: $0.10/$0.40 por 1M tokens (mais econômico)
SIMPLE_TASK_LLM_MODEL=gemini-2.5-flash-lite

# FALLBACK FREE TIER: quando o Gemini PAGO estoura 429 (prepayment depleted), o backend reenvia
# a MESMA chamada nesta 2ª chave (projeto Google SEM billing = free tier) usando FREE_LLM_MODEL.
# Vazio = sem fallback (comportamento atual, zero risco). Os gemini-3.x (3.5-flash etc.) NÃO têm
# free tier — só o gemini-3-flash-preview, mas com cota instável (preview, Google muda direto).
# Recomendado: gemini-2.5-flash (estável, confirmado no free: ~10 RPM / 250 req-dia). Mais cota
# diária: gemini-2.5-flash-lite (~15 RPM / 1000 req-dia, qualidade menor).
# GEMINI_FREE_API_KEY=AIza...   # chave de um projeto Google Cloud SEM billing
# FREE_LLM_MODEL=gemini-2.5-flash

# IMAGE ANALYST: Diagnóstico por imagem
# Gemini 3 Flash: Raciocínio visual avançado, code execution para zoom/edit
MEDICAL_IMAGE_ANALYST_MODEL=gemini-3-flash-preview
# IMAGE GEN: Geração de ilustrações médicas e avatares
IMAGE_GEN_MODEL=gemini-2.5-flash-image-preview
# IMAGE GEN PRO: Modelo de alta qualidade p/ materiais (mapas mentais). Opcional — fallback p/ IMAGE_GEN_MODEL
IMAGE_GEN_MODEL_PRO=
# VISION: Descrição de imagens médicas extraídas de PDFs da biblioteca (default: gemini-2.5-flash-lite)
VISION_DESCRIPTION_MODEL=gemini-2.5-flash-lite

# GROUNDING: Busca web para referências científicas
# 1,500 consultas/dia grátis, depois $35/1000 consultas
ENABLE_GROUNDING=1

# NCBI PUBMED API KEY (opcional): valida/enriquece citações via PubMed E-utilities.
# Sem chave = ~3 req/s compartilhado por IP (referências falham sob carga).
# Com chave = ~10 req/s. Gere em https://www.ncbi.nlm.nih.gov/account/ (Settings → API Key).
NCBI_API_KEY=

# ============================================================
# VERIFICAÇÃO DE DOCUMENTOS (KYC) - Gemini Dedicado
# ============================================================
# Chave Gemini separada para controle de orçamento de verificação de documentos
# Usar uma API Key dedicada permite monitorar custos de KYC separadamente
GEMINI_DOCSVERIFICATION_KEY=sua_chave_gemini_para_kyc

# ============================================================
# INTEGRAÇÕES DE TERCEIROS (OPCIONAL)
# ============================================================
# OpenRouter (fallback/outros usos)
OPENROUTER_API_KEY=sua_chave_openrouter

# Transcrição de áudio/vídeo da biblioteca — PRIMÁRIO: self-host (whisper.service).
# Se WHISPER_SERVER_URL estiver setado, usa o faster-whisper local (large-v3-turbo,
# sem cota/API externa). Vazio = usa a Groq (fallback / dev local).
WHISPER_SERVER_URL=http://127.0.0.1:8002
# WHISPER_REQUEST_TIMEOUT=5400   # timeout do request ao whisper.service (s); default 1.5h
# Tunáveis do whisper.service (lidos por backend/whisper_server.py):
# WHISPER_MODEL=large-v3-turbo
# WHISPER_COMPUTE_TYPE=int8
# WHISPER_CPU_THREADS=4
# WHISPER_LANGUAGE=          # vazio = auto-detecção pt/en/es

# Groq (FALLBACK de transcrição quando WHISPER_SERVER_URL está vazio). Free tier oscila
# sob uso intenso — por isso o self-host é o primário. console.groq.com → API Keys.
GROQ_API_KEY=sua_chave_groq
# GROQ_TRANSCRIPTION_MODEL=whisper-large-v3-turbo
# TRANSCRIPTION_LANGUAGE=

# Hugging Face (legado — não mais usado; transcrição é Groq, avatar é Gemini)
HUGFACE_API_TOKEN_WHISPER=sua_chave_huggingface
HUGGINGFACE_API_KEY=sua_chave_huggingface

# ChromaDB em modo SERVIDOR (produção). Se setado, o backend usa HttpClient em vez de
# PersistentClient (que segfaulta com múltiplos workers). Servidor: chroma.service
# (`chroma run --path ./chroma_db --port 8001`). Vazio = PersistentClient (dev local).
CHROMA_SERVER_HOST=127.0.0.1
CHROMA_SERVER_PORT=8001

# RAG v2 — embeddings/rerank via embedder.service (e5-base + cross-encoder, porta 8003).
# MASTER SWITCH: se EMBED_SERVER_URL estiver setado, a busca da biblioteca usa o pipeline v2
# (e5 multilíngue + BM25 + RRF + rerank, coleções library_{id}_e5). Vazio = RAG v1 (MiniLM
# local, dense puro) — comportamento legado, idêntico ao de antes. Rollback = limpar a var.
# Pré-requisito: embedder.service no ar + rodar backend/scripts/reindex_to_v2.py uma vez.
# EMBED_SERVER_URL=http://127.0.0.1:8003
# EMBED_REQUEST_TIMEOUT=120
# EMBED_MODEL=intfloat/multilingual-e5-base
# RERANK_MODEL=cross-encoder/mmarco-mMiniLMv2-L12-H384-v1
# ENABLE_RERANK=1            # 0 desliga o reranker no serviço (economiza RAM/latência)
# RAG_HYBRID=1              # 0 desliga o BM25 (só denso)
# RAG_RERANK=1             # 0 desliga o rerank no backend (usa ordem do RRF)
# RAG_RETRIEVE_K=20        # candidatos recuperados antes do rerank
# RAG_TOP_K=5             # resultado final default
# EMBED_NAMESPACE=e5      # sufixo das coleções v2 (não mexer após migrar)

# ============================================================
# URLs PÚBLICAS (BACKEND)
# ============================================================
# WEB_BASE_URL: URL canônica do site (usada em emails, links de pagamento, deep links)
# API_BASE_URL: URL pública da API (default = {WEB_BASE_URL}/api)
WEB_BASE_URL=https://qython.ai
API_BASE_URL=https://qython.ai/api

# CORS allow-list (comma-separated). Sem espaços entre vírgulas.
ALLOWED_ORIGINS=http://localhost:3000,https://qython.ai,https://www.qython.ai

# Hosts confiáveis para TrustedHostMiddleware (comma-separated)
ALLOWED_HOSTS=localhost,127.0.0.1,qython.ai,*.qython.ai

# ============================================================
# EMAIL (Resend)
# ============================================================
# Obtenha sua API Key em: https://resend.com/api-keys
# Plano gratuito: 3.000 emails/mês (100/dia)
#
# Para usar domínio personalizado (recomendado):
# 1. Adicione qython.ai no Resend (Domains)
# 2. Configure os registros DNS (TXT, CNAME, MX)
# 3. Após verificar, mude MAIL_FROM_EMAIL para: nao-responda@qython.ai
RESEND_API_KEY=re_123abc...
MAIL_FROM_EMAIL=nao-responda@qython.ai

# ============================================================
# PAGAMENTOS (OPCIONAL - STRIPE)
# ============================================================
STRIPE_API_KEY=sk_test_sua_chave
STRIPE_WEBHOOK_SECRET=whsec_sua_chave

# ============================================================
# PAGAMENTOS - dLocal Go (cartão + PIX/boleto + métodos LatAm, cross-border)
# ============================================================
# Chaves do dashboard dLocal Go (sandbox: dashboard-sbx.dlocalgo.com/signup).
# O HMAC do webhook reusa API_KEY + SECRET_KEY (sem secret de webhook separado).
DLOCAL_API_KEY=
DLOCAL_SECRET_KEY=
DLOCAL_ENV=sbx            # sbx (sandbox) | live (produção)
DLOCAL_CURRENCY=USD       # USD = cross-border; ajuste após validar no sandbox (ex.: BRL)
DLOCAL_COUNTRY=           # vazio = dLocal detecta no checkout (ex.: BR p/ forçar Brasil)

# ============================================================
# FRONTEND (VITE)
# ============================================================
VITE_API_URL=https://qython.ai/api
VITE_API_URL_FOR_STATIC_FILES=https://qython.ai

# PostHog Analytics (opcional)
# VITE_POSTHOG_KEY=sua_chave_posthog

# ============================================================
# FIREBASE (Verificação de Telefone por SMS)
# ============================================================
# Obtenha em: Firebase Console → Project Settings → General → Your Apps
# Também baixe firebase_credentials.json (Service Accounts) para a raiz do projeto
VITE_FIREBASE_API_KEY=AIza...
VITE_FIREBASE_AUTH_DOMAIN=seu-projeto.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=seu-projeto-id
VITE_FIREBASE_STORAGE_BUCKET=seu-projeto.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789
VITE_FIREBASE_APP_ID=1:123456789:web:abc123

# ============================================================
# CONFIGURAÇÕES AVANÇADAS (PADRÕES RECOMENDADOS)
# ============================================================
# Configuração de tokens LLM
DEFAULT_MAX_TOKENS_COMPLEX=8192
DEFAULT_MAX_TOKENS_CHAT=8192
DEFAULT_MAX_TOKENS_SUMMARY=4096
DEFAULT_MAX_TOKENS_IMPROVE_NOTES=16384
DEFAULT_MAX_TOKENS_SIMPLE=1024

# Cache de prompts (0 = desabilitado, 1 = habilitado)
ENABLE_PROMPT_CACHING=0

# Analytics (0 = desabilitado)
ENABLE_ANALYTICS=0
LANGCHAIN_TRACING_V2=false

# Caminho de fonte para PDFs (Linux padrão)
PDF_FONT_PATH=/usr/share/fonts/truetype/dejavu/DejaVuSans.ttf
