# ============================================================
# Qython - Variáveis de Ambiente
# ============================================================
# IMPORTANTE: Este arquivo (.env) contém credenciais sensíveis.
# NUNCA faça commit deste arquivo no Git!
# Copie .env.example para .env e preencha com suas credenciais reais.

# ============================================================
# BANCO DE DADOS (OBRIGATÓRIO)
# ============================================================
DATABASE_URL=postgresql://user:password@localhost:5432/qythondb?sslmode=require

# ============================================================
# AUTENTICAÇÃO E SEGURANÇA (OBRIGATÓRIO)
# ============================================================
JWT_SECRET_KEY=sua_chave_jwt_secreta_minimo_32_caracteres
ACCESS_TOKEN_EXPIRE_MINUTES=720

# ------------------------------------------------------------
# TRAVAS DE CADASTRO (OPCIONAIS)
# ------------------------------------------------------------
# Numa instalação local nenhuma delas é necessária: a primeira conta vira a
# administradora e as seguintes esperam a liberação dela. Cada chave abaixo,
# quando preenchida, LIGA uma trava. Deixe comentado o que você não usa; um valor
# de exemplo preenchido liga a trava e o cadastro passa a falhar.
#
# Cloudflare Turnstile (captcha no cadastro, para servidor exposto na internet)
# CLOUDFLARE_SECRET_KEY=sua_chave_secreta_cloudflare
# CLOUDFLARE_SITE_KEY=sua_chave_site_cloudflare

# ============================================================
# INTELIGÊNCIA ARTIFICIAL
# ============================================================
# Padrão: IA local. O docker compose sobe o serviço `llm` (llama.cpp com o Gemma 4)
# e o backend fala com ele; nada sai do computador e não é preciso chave nenhuma.
# Fora do Docker, aponte LLM_BASE_URL para o seu llama-server ou Ollama.
# LLM_HF_REPO=ggml-org/gemma-4-26B-A4B-it-GGUF:Q4_0   # padrão: ~17 GB de RAM (máquina de 32 GB)
#                                                     # GPU de 24 GB: ggml-org/gemma-4-31B-it-GGUF:Q4_0
# LLM_THREADS=4
# LLM_CONTEXT_TOKENS=16384    # o mesmo -c do llama-server (ou num_ctx do Ollama)
# LLM_BASE_URL=http://llm:8080/v1             # fora do Docker: http://127.0.0.1:8081/v1
# LLM_MODEL=gemma-4                           # o Ollama exige o nome exato
# LLM_API_KEY=                                # só se o servidor pedir
# LLM_TIMEOUT_SECONDS=1800
# LOCAL_SIMULADO_QUESTIONS=10  # simulado da Arena com IA local: questões, em lotes de 5 (uns 3–8 min cada)
# Copiloto com IA local: antes de responder a uma pergunta clínica, busca fontes (catálogo de
# medicamentos, biblioteca escolhida, resumos do PubMed) e responde a partir delas, citando-as.
# COPILOT_LOCAL_SOURCES=1
# COPILOT_PUBMED=1             # 0 numa instalação sem internet (o PubMed recebe só os termos da busca)

# O Qython roda só com IA local: não há provedor em nuvem (nem Gemini) a configurar. Um modelo
# serve a tudo (consulta, chat, material, prova, visão): o que o servidor de IA carregou. Os
# papéis PRIMARY_LLM_MODEL, FALLBACK_LLM_MODEL, SIMPLE_TASK_LLM_MODEL, CHAT_LLM_MODEL,
# MATERIAL_LLM_MODEL, EXAM_LLM_MODEL e VISION_DESCRIPTION_MODEL valem "local" e não precisam
# ser definidos.
#
# OCR de PDF escaneado e foto de documento: RapidOCR (PP-OCRv6), local. O modelo médio vem na
# imagem Docker (QYTHON_OCR_MODELS); QYTHON_OCR_MODELO=pequeno força o pequeno em máquina lenta.
# QYTHON_OCR_THREADS=2

# NCBI PUBMED API KEY (opcional): valida/enriquece citações via PubMed E-utilities.
# Sem chave = ~3 req/s compartilhado por IP (referências falham sob carga).
# Com chave = ~10 req/s. Gere em https://www.ncbi.nlm.nih.gov/account/ (Settings → API Key).
NCBI_API_KEY=

# ============================================================
# INTEGRAÇÕES DE TERCEIROS (OPCIONAL)
# ============================================================
# Transcrição de áudio/vídeo da biblioteca: faster-whisper local (whisper.service, large-v3-turbo).
# Não há serviço de transcrição em nuvem: sem WHISPER_SERVER_URL a transcrição fica indisponível.
WHISPER_SERVER_URL=http://127.0.0.1:8002
# WHISPER_REQUEST_TIMEOUT=5400   # timeout do request ao whisper.service (s); default 1.5h
# Tunáveis do whisper.service (lidos por backend/whisper_server.py):
# WHISPER_MODEL=large-v3-turbo
# WHISPER_COMPUTE_TYPE=int8
# WHISPER_CPU_THREADS=4
# WHISPER_LANGUAGE=          # vazio = auto-detecção pt/en/es

# ChromaDB em modo SERVIDOR (produção). Se setado, o backend usa HttpClient em vez de
# PersistentClient (que segfaulta com múltiplos workers). Servidor: chroma.service
# (`chroma run --path ./chroma_db --port 8001`). Vazio = PersistentClient (dev local).
CHROMA_SERVER_HOST=127.0.0.1
CHROMA_SERVER_PORT=8001

# Busca da biblioteca: embeddings e5 + reranker pelo serviço embedder (backend/embed_onnx.py, ONNX, porta
# 8003). No Docker o compose já define EMBED_SERVER_URL; fora dele, aponte para o serviço. Sem ele a busca
# (e a indexação de documentos) fica indisponível. Instalação vinda de uma versão anterior: reindexe uma vez
# com `python -m backend.scripts.reindex_to_v2`.
# EMBED_SERVER_URL=http://127.0.0.1:8003
# EMBED_MODEL_DIR=/caminho/e5-base-int8     # pasta com model.onnx e tokenizer.json (scripts/fetch_models.py baixa)
# RERANK_MODEL_DIR=/caminho/rerank-mmarco-int8   # opcional; sem ele a ordem fica a da fusão RRF
# EMBED_REQUEST_TIMEOUT=120
# RAG_HYBRID=1              # 0 desliga o BM25 (só denso)
# RAG_RERANK=1             # 0 desliga o rerank no backend (usa ordem do RRF)
# RAG_RETRIEVE_K=20        # candidatos recuperados antes do rerank
# RAG_TOP_K=5             # resultado final default
# EMBED_NAMESPACE=e5      # sufixo das coleções (library_{id}_e5); não mexer depois de indexar

# ============================================================
# URLs PÚBLICAS (BACKEND)
# ============================================================
# WEB_BASE_URL: URL canônica do site (usada em emails, links de pagamento, deep links)
# API_BASE_URL: URL pública da API (default = {WEB_BASE_URL}/api)
WEB_BASE_URL=https://qython.ai
API_BASE_URL=https://qython.ai/api

# CORS allow-list (comma-separated). Sem espaços entre vírgulas.
ALLOWED_ORIGINS=http://localhost:3000,https://qython.ai,https://www.qython.ai

# Hosts confiáveis para TrustedHostMiddleware (comma-separated)
ALLOWED_HOSTS=localhost,127.0.0.1,qython.ai,*.qython.ai

# ============================================================
# EMAIL (Resend) — OPCIONAL
# ============================================================
# Com a chave preenchida, o cadastro passa a exigir a confirmação do e-mail e o
# "Esqueci minha senha" passa a funcionar. Sem ela, a senha se redefine pelo
# terminal: python -m backend.scripts.reset_password <email>
# Obtenha sua API Key em: https://resend.com/api-keys
# Plano gratuito: 3.000 emails/mês (100/dia)
#
# Para usar domínio personalizado (recomendado):
# 1. Adicione qython.ai no Resend (Domains)
# 2. Configure os registros DNS (TXT, CNAME, MX)
# 3. Após verificar, mude MAIL_FROM_EMAIL para: nao-responda@qython.ai
# RESEND_API_KEY=re_123abc...
# MAIL_FROM_EMAIL=nao-responda@seu-dominio.com

# ============================================================
# PAGAMENTOS (só na edição hosted)
# ============================================================
# STRIPE_API_KEY=sk_test_sua_chave
# STRIPE_WEBHOOK_SECRET=whsec_sua_chave

# ============================================================
# PAGAMENTOS - dLocal Go (cartão + PIX/boleto + métodos LatAm, cross-border)
# ============================================================
# Chaves do dashboard dLocal Go (sandbox: dashboard-sbx.dlocalgo.com/signup).
# O HMAC do webhook reusa API_KEY + SECRET_KEY (sem secret de webhook separado).
DLOCAL_API_KEY=
DLOCAL_SECRET_KEY=
DLOCAL_ENV=sbx            # sbx (sandbox) | live (produção)
DLOCAL_CURRENCY=USD       # USD = cross-border; ajuste após validar no sandbox (ex.: BRL)
DLOCAL_COUNTRY=           # vazio = dLocal detecta no checkout (ex.: BR p/ forçar Brasil)

# ============================================================
# FRONTEND (VITE)
# ============================================================
# Relativo: o front e a API na mesma origem (docker compose, ou o proxy do
# `npm run dev`, que encaminha /api para http://localhost:8000).
VITE_API_URL=/api

# PostHog Analytics (opcional)
# VITE_POSTHOG_KEY=sua_chave_posthog

# ============================================================
# FIREBASE (login com Google e verificação de telefone por SMS) — OPCIONAL
# ============================================================
# Obtenha em: Firebase Console → Project Settings → General → Your Apps
# O backend liga as duas coisas quando encontra config/firebase_credentials.json
# (Service Accounts); com ele presente, o cadastro passa a exigir o SMS.
# VITE_FIREBASE_API_KEY=AIza...
# VITE_FIREBASE_AUTH_DOMAIN=seu-projeto.firebaseapp.com
# VITE_FIREBASE_PROJECT_ID=seu-projeto-id
# VITE_FIREBASE_STORAGE_BUCKET=seu-projeto.appspot.com
# VITE_FIREBASE_MESSAGING_SENDER_ID=123456789
# VITE_FIREBASE_APP_ID=1:123456789:web:abc123

# ============================================================
# CONFIGURAÇÕES AVANÇADAS (PADRÕES RECOMENDADOS)
# ============================================================
# Configuração de tokens LLM
DEFAULT_MAX_TOKENS_COMPLEX=8192
DEFAULT_MAX_TOKENS_CHAT=8192
DEFAULT_MAX_TOKENS_SUMMARY=4096
DEFAULT_MAX_TOKENS_IMPROVE_NOTES=16384
DEFAULT_MAX_TOKENS_SIMPLE=1024

# Analytics (0 = desabilitado)
ENABLE_ANALYTICS=0
LANGCHAIN_TRACING_V2=false

# Caminho de fonte para PDFs (Linux padrão)
PDF_FONT_PATH=/usr/share/fonts/truetype/dejavu/DejaVuSans.ttf
